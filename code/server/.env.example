DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ONEBOT_API=http://127.0.0.1:3000
ONEBOT_TOKEN=
BOT_QQ=
ALLOWED_GROUPS=
POLL_INTERVAL=2.0
MIN_REPLY_INTERVAL=40
MAX_PARTS=3
PROB_IDLE=0.03
DROP_PROB=0.08
# 被 @ 时不受同群冷却限制。0 = 永不丢点名（「@ 必回」）。想防刷屏再调大。
MENTION_MIN_INTERVAL=0

# ---- 额度监控（估算）----
# 单价按阿里云试用额度页的实测值校准；提醒发到下面这个 QQ（默认主号）
SPEND_HOUR_RATE=0.254
SPEND_TRAFFIC_RATE=0.8
SPEND_FREE_TRAFFIC_GB=20
SPEND_TOTAL_QUOTA=300
SPEND_QUOTA_EXPIRE=2027-01-10
SPEND_ALERT_AT=200
SPEND_ALERT_QQ=              # 额度提醒发到哪个 QQ（留空则不提醒）

# ---- DeepSeek 余额监控（另一个钱包）----
# 余额低于这个数就提醒你充值
DEEPSEEK_ALERT_AT=10

# ---- 备用 API 线路 ----
# 支持多级降级，前面的挂了自动往后换。编号越小优先级越高。
# NOTE 字段只是给人看的备注（会显示在线路清单里），可以写到期时间。
# 规则：官方 key 一律排在前面，中转站永远放最后一条。
# 加新线路：接着往下写 FALLBACK5_*，再在 config.py 的 _build_providers() 里 add() 一行。

# 备用1：官方 key B
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.deepseek.com
FALLBACK_MODEL=deepseek-chat
FALLBACK_NOTE=

# 备用2：官方 key C（注意：官方 key 的余额是「账号级」的，
#        同一账号下如果还有别的 key 在别处使用，会一起消耗这个余额）
FALLBACK2_API_KEY=
FALLBACK2_BASE_URL=https://api.deepseek.com
FALLBACK2_MODEL=deepseek-chat
FALLBACK2_NOTE=

# 备用3：官方 key D
FALLBACK3_API_KEY=
FALLBACK3_BASE_URL=https://api.deepseek.com
FALLBACK3_MODEL=deepseek-chat
FALLBACK3_NOTE=

# 备用4：中转站兜底（注意：中转站的「令牌」和官方 key 不通用，要去它后台单独建）
FALLBACK4_API_KEY=
FALLBACK4_BASE_URL=https://api.bingheai.org/v1
FALLBACK4_MODEL=deepseek-4.1-flash
FALLBACK4_NOTE=中转站

# ---- 冷场救场 ----
# 想关掉自动发表情包就设成 0
COLD_STICKER_PROB=0.25
COLD_SILENCE_MIN=60

# ---- 什么时候允许机器人开口（车主定的规矩）----
# 只有被 @ 才回；没被点名的一律不接（管它是不是问句、有没有数学词）
MENTION_ONLY=1

# 没被点名时是否允许主动搭话（闲聊插嘴）。关了就是个纯点名答疑机器人。
IDLE_CHAT_ENABLED=0

# 这些名字出现在消息里（哪怕没带 @ 段）就一律不插嘴 —— 说明话不是说给它的。
# 主要防"群里 @ 别的机器人时它跟着冒出来"。逗号分隔。
IGNORE_NAMES=凛音,凛音同学,muse
