DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ONEBOT_API=http://127.0.0.1:3000
ONEBOT_TOKEN=
BOT_QQ=
ALLOWED_GROUPS=
POLL_INTERVAL=2.0
MIN_REPLY_INTERVAL=40
MAX_PARTS=3
PROB_IDLE=0.03
DROP_PROB=0.08
# 被 @ 时不受同群冷却限制。0 = 永不丢点名（「@ 必回」）。想防刷屏再调大。
MENTION_MIN_INTERVAL=0

# ---- 额度监控（估算）----
# 单价按阿里云试用额度页的实测值校准；提醒发到下面这个 QQ（默认主号）
SPEND_HOUR_RATE=0.254
SPEND_TRAFFIC_RATE=0.8
SPEND_FREE_TRAFFIC_GB=20
SPEND_TOTAL_QUOTA=300
SPEND_QUOTA_EXPIRE=2027-01-10
SPEND_ALERT_AT=200
SPEND_ALERT_QQ=              # 额度提醒发到哪个 QQ（留空则不提醒）

# ---- DeepSeek 余额监控（另一个钱包）----
# 余额低于这个数就提醒你充值
DEEPSEEK_ALERT_AT=10

# ---- 备用 API 线路 ----
# 支持多级降级，前面的挂了自动往后换。编号越小优先级越高。
# NOTE 字段只是给人看的备注（会显示在线路清单里），可以写到期时间。
# 规则：官方 key 一律排在前面，中转站永远放最后一条。
# 加新线路：接着往下写 FALLBACK4_*，再在 config.py 的 _build_providers() 里 add() 一行。

# 备用1：官方 key B
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.deepseek.com
FALLBACK_MODEL=deepseek-chat
FALLBACK_NOTE=

# 备用2：官方 key E（10-17 到期）
FALLBACK2_API_KEY=
FALLBACK2_BASE_URL=https://api.deepseek.com
FALLBACK2_MODEL=deepseek-chat
FALLBACK2_NOTE=

# 备用3：官方 key C（无到期日）
FALLBACK3_API_KEY=
FALLBACK3_BASE_URL=https://api.deepseek.com
FALLBACK3_MODEL=deepseek-chat
FALLBACK3_NOTE=

# 备用3（原官方D）已于 2026-10-10 撤掉 —— 车主拿那把 key 去开发了。
# 要恢复就取消下面注释，并在 config.py 的 _build_providers() 里把 add() 加回来。
# FALLBACK3_API_KEY=

# 备用4：小米 MiMo V2.6 Pro（11-10 到期，¥10 额度）
# 车主 2026-10-11 加：比 Flash 优先级高（先用好模型）。
# 小米线同款规矩：不要关思考（它会自己判断想多少），多模态好。
FALLBACK4_API_KEY=
FALLBACK4_BASE_URL=https://api.xiaomimimo.com/v1
FALLBACK4_MODEL=mimo-v2.6-pro
FALLBACK4_NOTE=

# 备用5：小米 MiMo Flash（Xiaomi MiMo API 开放平台，40 天期）
FALLBACK5_API_KEY=
FALLBACK5_BASE_URL=https://api.xiaomimimo.com/v1
FALLBACK5_MODEL=mimo-v2.6-flash
FALLBACK5_NOTE=

# 备用6：火山方舟（Volcengine Ark）
# ⚠️ 这个模型是**推理型**，代码里已强制 thinking=disabled。
#    不关思考的话 reasoning 会吃光 max_tokens，导致正文返回空字符串 ——
#    实测 max_tokens=50 时正文完全是空的。详见 config.py 里的注释。
FALLBACK6_API_KEY=
FALLBACK6_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FALLBACK6_MODEL=deepseek-v4-1-flash-260910
FALLBACK6_NOTE=火山方舟

# 备用7：中转站兜底（永远放最后）
# 注意：中转站的「令牌」和官方 key 不通用，要去它后台单独建
FALLBACK7_API_KEY=
FALLBACK7_BASE_URL=https://api.bingheai.org/v1
FALLBACK7_MODEL=deepseek-4.1-flash
FALLBACK7_NOTE=中转站

# ---- 表格算术自检（2026-10-10 新增，默认开）----
# 单纯形表先验算再发：代码重算 σ 行 / 带错误清单让模型重算 / 兜底标注
TABLECHECK_ENABLED=1
TABLECHECK_MAX_REVISE=1
TABLECHECK_ANNOTATE=1

# ---- PDF 解题任务（群友引用 PDF + @机器人，默认开）----
# 转换本地零消耗；解题那一次调用输入≈全文 token。防刷冷却与上限：
PDF_TASK_ENABLED=1
PDF_TASK_COOLDOWN=120
PDF_TASK_MAX_CHARS=30000
PDF_TASK_MAX_PAGES=60

# ---- 周末平安值守（车主个人安全功能，2026-10-11 定，详见 safety.py）----
# 车主私信「开启安全保镖」才生效；两个 QQ 都必须是机器人好友；OWNER_QQ 空 = 功能关闭
SAFETY_CHECK_ENABLED=1
SAFETY_OWNER_QQ=
SAFETY_CONTACT_QQ=
SAFETY_ALERT_HOUR=21
SAFETY_FRIDAY_DM_HOUR=20

# ---- 私信问答（白名单制，默认开）----
# 名单里的好友私信机器人可正常问答；逗号分隔；安全保镖通道自动排除
PM_CHAT_ENABLED=1
PM_CHAT_USERS=
